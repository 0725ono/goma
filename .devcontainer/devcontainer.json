{
  "name": "Family Schedule API Dev",
  "dockerComposeFile": "../docker-compose.yml",
  "service": "workspace",
  "workspaceFolder": "/workspace",

  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "17"
    }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "vscjava.vscode-spring-boot-dashboard" // Java開発用に追加をおすすめします
      ]
    }
  },

  // ポート公開は docker-compose.yml で行う（ホスト 18080→API, 15432→PostgreSQL）。
  // VS Code の forwardPorts はホスト側の 8080/5432（別プロジェクトが使用）と衝突するため使わない。
  "remoteUser": "vscode"
}

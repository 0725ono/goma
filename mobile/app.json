{
  "expo": {
    "name": "mobile",
    "slug": "schedule-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.familyschedule.mobile"
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.familyschedule.mobile"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f46e8fcd-d0a0-4ac2-87f1-d92dbd516c17"
      }
    },
    "owner": "onomas-team"
  }
}
